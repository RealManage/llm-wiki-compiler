#!/usr/bin/env bash
# Shared context helper for llm-wiki-compiler.
# Prints wiki session guidance as plain text when .wiki-compiler.json is
# present in the cwd or any ancestor up to $HOME.

set -euo pipefail

# ASCII printable + tab only, capped at 200 BYTES TOTAL. LC_ALL=C forces
# byte-wise matching so locale-dependent definitions of [:print:] can't
# let high bytes through (e.g., UTF-8 U+2028/U+2029 line separators
# would render as newlines in the LLM-facing banner).
#
# Implemented as a single-process awk (not `tr -cd ... | head -c 200`)
# to avoid SIGPIPE on long upstream output: `head` would close its stdin
# after 200 bytes, the upstream `tr` would exit 141 on its next write,
# pipefail propagates 141 through `$(...)`, and `set -euo pipefail` kills
# the script silently.
#
# Accumulate-then-truncate-in-END (not per-record `printf "%.200s"`) so
# the 200-byte cap applies to TOTAL output, not per record:
#   - awk's default RS="\n" splits input on newlines (each line a record).
#     Newlines themselves get stripped by gsub, so an attacker can't
#     smuggle a separator into the output, but each record's bytes are
#     still subject to the same allowed-byte filter and contribute to a
#     single accumulator.
#   - A naive per-record `printf "%.200s"` would cap each record at 200
#     bytes independently — letting an attacker exceed the total cap by
#     splitting their payload across records (newlines or NUL bytes).
#     The earlier RS="\0" version had this exact bypass AND was non-
#     portable: mawk and BSD awk don't honor RS="\0" cleanly.
#
# %.200s is byte-safe ONLY because the filter restricts to single-byte
# ASCII. If anyone widens the gsub range to include multi-byte UTF-8,
# switch to a character-aware truncator to avoid splitting a sequence.
sanitize() {
  LC_ALL=C awk '
    BEGIN { ORS=""; out="" }
    { gsub(/[^\t\040-\176]/, ""); out = out $0 }
    END   { print substr(out, 1, 200) }
  '
}

# Reject path-traversal strings. Used on output_path before any filesystem
# concatenation so a malicious config can't make the hook probe arbitrary
# locations (and then advertise their existence by emitting a "Location:"
# line referencing them). Rejects empty, absolute paths, and any path
# whose substring contains ".." (mildly over-restrictive — filenames like
# "foo..bar" are also rejected — but legitimate output paths don't use
# such names).
is_safe_relpath() {
  case "$1" in
    ""|/*|*..*) return 1 ;;
    *) return 0 ;;
  esac
}

# Resolve the upper bound for the config-file upward walk. Returns $HOME
# for work under the user's home dir (preserves the documented ~/Knowledge
# global-wiki and ~/projects local-wiki layouts), the enclosing git repo
# root for work outside $HOME (covers /data/, /srv/, /opt/, /tmp/scratch-
# repo), or empty if neither applies (stray configs in /tmp/, /etc/, /
# have no legitimate location to live).
#
# Defenses: $HOME may be unset, set to "/", or have a trailing slash;
# all three are handled. Windows-style paths from git on git-bash
# (C:/Users/...) are normalized via cygpath -u to match MSYS-style
# ($HOME, $PWD).
resolve_search_bound() {
  local start="$1"
  local home="${HOME:-}"
  home="${home%/}"
  if [ -n "$home" ] && [ "$home" != "/" ]; then
    case "$start" in
      "$home"|"$home"/*)
        printf '%s' "$home"
        return
        ;;
    esac
  fi
  local toplevel
  toplevel="$(git -C "$start" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$toplevel" ] && command -v cygpath >/dev/null 2>&1; then
    toplevel="$(cygpath -u "$toplevel" 2>/dev/null || printf '%s' "$toplevel")"
  fi
  printf '%s' "$toplevel"
}

config_file=""
dir="${1:-$PWD}"
start_dir="$dir"
bound="$(resolve_search_bound "$start_dir")"

if [ -n "$bound" ]; then
  while [ -n "$dir" ] && [ "$dir" != "/" ]; do
    if [ -f "$dir/.wiki-compiler.json" ]; then
      config_file="$dir/.wiki-compiler.json"
      break
    fi
    [ "$dir" = "$bound" ] && break
    dir="$(dirname "$dir")"
  done
fi

if [ -z "$config_file" ]; then
  exit 0
fi

project_root="$(dirname "$config_file")"

# JSON.parse, not require() — so a JS-payload config can't execute.
#
# CAUTION: $expr is interpolated into the JS source as text. Every
# current caller passes a hardcoded literal. Never pass a runtime
# variable here without escaping or you reintroduce JS injection —
# the file path is the safe param, the JS expression is not.
read_config() {
  local file="$1"
  local expr="$2"
  CONFIG_FILE="$file" node -e "
    const fs = require('fs');
    const c = JSON.parse(fs.readFileSync(process.env.CONFIG_FILE, 'utf8'));
    ${expr}
  " 2>/dev/null
}

# Same $expr literal-only contract as read_config. Fallback is passed
# via env var so a value containing a quote or backslash can't escape
# into the node -e program.
read_state() {
  local file="$1"
  local expr="$2"
  local fallback="$3"
  STATE_FILE="$file" STATE_FALLBACK="$fallback" node -e "
    const fs = require('fs');
    try {
      const s = JSON.parse(fs.readFileSync(process.env.STATE_FILE, 'utf8'));
      ${expr}
    } catch (e) {
      process.stdout.write(process.env.STATE_FALLBACK || '');
    }
  " 2>/dev/null || printf '%s' "$fallback"
}

output_path="$(read_config "$config_file" "console.log(c.output || '')" | sanitize)"
mode="$(read_config "$config_file" "console.log(c.mode || 'staging')" | sanitize)"
name="$(read_config "$config_file" "console.log(c.name || 'Project')" | sanitize)"
wiki_mode="$(read_config "$config_file" "console.log(c.mode === 'codebase' ? 'codebase' : 'knowledge')" 2>/dev/null | sanitize)"
[ -z "$wiki_mode" ] && wiki_mode="knowledge"

# Reject empty, absolute, and traversal-bearing output paths before we
# concatenate output_path into filesystem probes. Without this, "output":
# "../../../.." in a malicious config makes the hook probe /INDEX.md and
# (on a hit) emit "Location: ../../../.." into the LLM banner — an
# arbitrary-existence-probe + a small information-disclosure / injection
# compound. is_safe_relpath also rejects "" so this single gate handles
# both the empty-config-output case and the traversal case.
if ! is_safe_relpath "$output_path"; then
  exit 0
fi

index_file="$project_root/$output_path/INDEX.md"
state_file="$project_root/$output_path/.compile-state.json"

if [ ! -f "$index_file" ]; then
  printf '[Wiki Compiler] Wiki configured for "%s" but not yet compiled. In Claude, run /wiki-compile. In Codex, ask: "Compile changed sources into the wiki."\n' "$name"
  exit 0
fi

# State file is repo-shipped (lives under $output_path) and therefore
# part of the same attacker model as .wiki-compiler.json. A poisoned
# last_compiled value with embedded newlines would otherwise leak
# straight into the LLM banner. Sanitize for the same reason as config.
topic_count="$(read_state "$state_file" "console.log((s.topics||[]).length)" "?" | sanitize)"
last_compiled="$(read_state "$state_file" "console.log(s.last_compiled || 'unknown')" "unknown" | sanitize)"
auto_update="$(read_config "$config_file" "console.log(c.auto_update || 'off')" 2>/dev/null | sanitize)"
[ -z "$auto_update" ] && auto_update="off"

stale_warning=""
bookmark_count=0
if [ "$auto_update" = "prompt" ] && [ "$last_compiled" != "unknown" ]; then
  sources_json="$(read_config "$config_file" "(c.sources||[]).forEach(s => console.log(s.path || ''))" 2>/dev/null || true)"
  changed_count=0
  while IFS= read -r src_path; do
    if [ -z "$src_path" ]; then
      continue
    fi
    if [[ "$src_path" == ~/* || "$src_path" == "~" ]]; then
      resolved_path="${src_path/#\~/$HOME}"
    else
      resolved_path="$project_root/$src_path"
    fi
    if [ -d "$resolved_path" ]; then
      ref_file="$(mktemp)"
      touch -t "$(echo "$last_compiled" | sed 's/-//g')0000" "$ref_file" 2>/dev/null || true
      if [ "$wiki_mode" = "codebase" ]; then
        count="$(find "$resolved_path" \
          \( -name "README.md" -o -name "CLAUDE.md" -o -name "AGENTS.md" -o -name "ARCHITECTURE.md" \
             -o -name "CONTRIBUTING.md" -o -name "CHANGELOG.md" \
             -o -name "*.proto" -o -name "*.graphql" \
             -o -name "openapi.yaml" -o -name "openapi.json" \
             -o -name "ADR-*.md" \
             -o -name "docker-compose.yml" -o -name "Dockerfile" \
             -o -name ".env.example" \
             -o -name "package.json" -o -name "go.mod" -o -name "Cargo.toml" -o -name "pyproject.toml" \) \
          -not -path "*/node_modules/*" -not -path "*/.git/*" -not -path "*/dist/*" \
          -not -path "*/vendor/*" -not -path "*/__pycache__/*" -not -path "*/.build/*" \
          -newer "$ref_file" 2>/dev/null | wc -l | tr -d ' ')"
      else
        count="$(find "$resolved_path" -name "*.md" -newer "$ref_file" 2>/dev/null | wc -l | tr -d ' ')"
      fi
      changed_count=$((changed_count + count))
      if [[ "$src_path" == *ft-bookmarks* || "$src_path" == *bookmarks/* ]]; then
        bookmark_count=$((bookmark_count + count))
      fi
      rm -f "$ref_file"
    fi
  done <<< "$sources_json"

  if [ "$changed_count" -gt 0 ]; then
    if [ "$bookmark_count" -gt 0 ] && [ "$bookmark_count" -eq "$changed_count" ]; then
      stale_warning="

$bookmark_count new bookmark(s) since last compile ($last_compiled). Compile the wiki to fold them into topics."
    elif [ "$bookmark_count" -gt 0 ]; then
      other=$((changed_count - bookmark_count))
      stale_warning="

Wiki may be stale: $bookmark_count new bookmark(s) + $other other file(s) changed since last compile ($last_compiled). Compile the wiki to update."
    else
      stale_warning="

Wiki may be stale: $changed_count files changed since last compile ($last_compiled). Compile the wiki to update."
    fi
  fi
fi

case "$mode" in
  staging)
    context="[Wiki Compiler] A compiled knowledge wiki is available for \"$name\".
Location: $output_path
Topics: $topic_count | Last compiled: $last_compiled
Mode: staging (supplements existing context)

When you need deep context on a topic, read ${output_path}INDEX.md to see available topics, then read specific topic articles. This wiki synthesizes source files into topic-based briefings; reading one topic article replaces reading 10-20 raw files.

Wiki articles are read-only synthesis. Never modify wiki/ files directly; they are regenerated by the compile workflow.${stale_warning}"
    ;;
  recommended)
    context="[Wiki Compiler] \"$name\" knowledge wiki active.
Location: $output_path
Topics: $topic_count | Last compiled: $last_compiled
Mode: recommended

For project context, start with ${output_path}INDEX.md. Read topic articles before reading raw source files. Fall back to raw sources only when the wiki article is insufficient or you need granular detail.

Wiki articles are read-only synthesis; they are regenerated by the compile workflow.${stale_warning}"
    ;;
  primary)
    context="[Wiki Compiler] \"$name\" wiki is the primary knowledge source.
Location: $output_path
Topics: $topic_count | Last compiled: $last_compiled

Read ${output_path}INDEX.md at session start. Only read raw source files when a wiki article's Sources section points you there for detail.

Wiki articles are read-only synthesis; they are regenerated by the compile workflow.${stale_warning}"
    ;;
  *)
    context="[Wiki Compiler] Wiki available for \"$name\" at $output_path ($topic_count topics, last compiled: $last_compiled). Compile the wiki to update.${stale_warning}"
    ;;
esac

# %s not %b — keep backslash sequences in $name/$output_path literal.
printf '%s\n' "$context"
